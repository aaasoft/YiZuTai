@inherits EditorBase<double?>

@if (Value == null)
{
    <span class="form-control">(未设置)</span>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-secondary" @onclick="@(e => Value = 0)">
            <i class="fa fa-plus" aria-hidden="true"></i>
        </button>
    </div>
}
else
{
    <InputNumber class="form-control" @bind-Value="Value"></InputNumber>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-danger" @onclick="@(e => Value = null)">
            <i class="fa fa-trash" aria-hidden="true"></i>
        </button>
    </div>
}