@inherits EditorBase<string>
@using YiZuTai.Utils

@if(Value==null)
{
    <span class="form-control">(未设置)</span>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-secondary" @onclick="@(e => Value = "#000000")"><i class="fa fa-plus" aria-hidden="true"></i></button>
    </div>
}
else
{
    <input class="form-control p-1" type="color" style="cursor: pointer;" @bind-value="Value">
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-danger" @onclick="@(e => Value = null)"><i class="fa fa-trash" aria-hidden="true"></i></button>
    </div>
}
