@using System.ComponentModel
@using Microsoft.JSInterop
@using YiZuTai.Control

@typeparam T_BaseControl_WithBackgroundAndAnimate where T_BaseControl_WithBackgroundAndAnimate : BaseControl_WithBackgroundAndAnimate, new()

<BaseControl_WithBackgroundView T_BaseControl_WithBackground="T_BaseControl_WithBackgroundAndAnimate" Model="Model"
    DesignMode="DesignMode">
    @ChildContent
    <!--非设计模式才加载动画-->
    @if(!DesignMode)
        {
        <!--旋转动画-->
        @if (!string.IsNullOrEmpty(Model.RotateDur))
        {
            <animateTransform attributeName="transform" attributeType="XML" type="rotate"
                from="0 @(Model.Left + Model.Width / 2) @(Model.Top + Model.Height / 2)"
                to="360 @(Model.Left + Model.Width / 2) @(Model.Top + Model.Height / 2)" dur="@Model.RotateDur"
                repeatCount="indefinite" />
        }
        <!--闪烁动画-->
        @if (!string.IsNullOrEmpty(Model.FlashDur))
        {
            <animate attributeName="opacity" values="1;0;1" dur="@Model.FlashDur" repeatCount="indefinite" />
        }
    }
</BaseControl_WithBackgroundView>

@code
{
    [Parameter]
    public T_BaseControl_WithBackgroundAndAnimate Model { get; set; }
    [Parameter]
    public bool DesignMode { get; set; } = false;
    [Parameter]
    public RenderFragment ChildContent { get; set; }
}