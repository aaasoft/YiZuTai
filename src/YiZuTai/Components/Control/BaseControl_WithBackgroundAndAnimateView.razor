@using System.ComponentModel
@using Microsoft.JSInterop
@using YiZuTai.Control

@typeparam T_BaseControl_WithBackgroundAndAnimate where T_BaseControl_WithBackgroundAndAnimate : BaseControl_WithBackgroundAndAnimate, new()

<BaseControl_WithBackgroundView T_BaseControl_WithBackground="T_BaseControl_WithBackgroundAndAnimate" Model="Model" DesignMode="DesignMode" @ref="ParentView">
    <!--数据部分-->
    <g @ref="dataElementReference" data-Angle="@Model.Angle"
        data-FlashInterval="@Model.FlashInterval"     
        data-RotateSpeed="@Model.RotateSpeed"
        data-CenterPointLocationX="@(Model.Left + Model.Width / 2)"
        data-CenterPointLocationY="@(Model.Top + Model.Height / 2)" />
    @ChildContent
</BaseControl_WithBackgroundView>