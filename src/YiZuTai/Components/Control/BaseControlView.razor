@using YiZuTai.Control
@typeparam T_BaseControl where T_BaseControl : BaseControl, new()

<svg  id="svg_@Model.Name" version="1.0" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="@Model.Left"
    y="@Model.Top" width="@Model.Width" height="@Model.Height" opacity="@Model.Opacity"
    visibility="@(Model.Visiable ? "visible" : "hidden")" @ref="svgElementReference">
    @ChildContent
</svg>

@code
{
    [Parameter]
    public T_BaseControl Model { get; set; }
    [Parameter]
    public bool DesignMode { get; set; } = false;
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    private ElementReference svgElementReference;
    public string Id => svgElementReference.Id;
}