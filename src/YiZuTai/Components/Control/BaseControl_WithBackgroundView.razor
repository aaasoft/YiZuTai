@using System.ComponentModel
@using YiZuTai.Control
@typeparam T_BaseControl_WithBackground where T_BaseControl_WithBackground : BaseControl_WithBackground, new()

<BaseControlView T_BaseControl="T_BaseControl_WithBackground" Model="Model" DesignMode="DesignMode" @ref="ParentView">
    <rect fill="@Model.Background" fill-opacity="@Model.BackgroundOpacity" rx="@Model.CornerRadius"
        ry="@Model.CornerRadius" stroke="@Model.Border" stroke-opacity="@Model.BorderOpacity"
        stroke-width="@Model.BorderThickness" x="@(Model.BorderThickness / 2)" y="@(Model.BorderThickness / 2)"
        width="@(Model.Width - Model.BorderThickness)" height="@(Model.Height - Model.BorderThickness)"></rect>
    @ChildContent
</BaseControlView>

@code {
    [Parameter]
    public T_BaseControl_WithBackground Model { get; set; }
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    private BaseControlView<T_BaseControl_WithBackground> ParentView;
    public string Id => ParentView.Id;
}
