@using YiZuTai.Control
@using YiZuTai.Enums
@using YiZuTai.Model
@typeparam TContainerModel where TContainerModel : BaseControl_WithBackground, new()

<g ondragover="event.preventDefault();" @ondrop="HandleDrop" @ondrop:stopPropagation>
<BaseControl_WithBackgroundView T_BaseControl_WithBackground="TContainerModel" Model="@Model"
    ZTContext="ZTContext">
    @ChildContent
    <!--====控件SVG部分====-->
    @if (Model.Controls != null)
    {
        @foreach (var Item in Model.Controls)
        {
            <g transform="rotate(@Item.Angle @Item.CenterPointLocation.X, @Item.CenterPointLocation.Y) translate(0, 0) scale(1)">
                @Item.GetView(@ZTContext)
            </g>
        }
    }
    @if(ZTContext.DesignMode)
    {
        @if(ZTContext.Designer.IsSelectedMutiControl && ((MultiControl)ZTContext.Designer.SelectedItem).Container==Model)
        {
            <BaseControlView T_BaseControl="MultiControl" Model="@((MultiControl)ZTContext.Designer.SelectedItem)" ZTContext="@ZTContext" >
            </BaseControlView>
        }
        @if(ZTContext.Designer.MouseDownControlMeta!=null
            && ZTContext.Designer.MouseDownControlMeta.MoveAction == MoveAction.Selecting
            && ZTContext.Designer.MouseDownControlMeta.MoveControl== Model)
        {
        <g>
            
            <rect x="@ZTContext.Designer.MouseDownControlMeta.MoveRect.X" y="@ZTContext.Designer.MouseDownControlMeta.MoveRect.Y"
                width="@ZTContext.Designer.MouseDownControlMeta.MoveRect.Width" height="@ZTContext.Designer.MouseDownControlMeta.MoveRect.Height" fill="#0078D7"
                fill-opacity="0.2" stroke="#0078D7" stroke-width="1"></rect>                                
        </g>
        }
    }
</BaseControl_WithBackgroundView>
</g>

@code
{
    [Parameter]
    public ZTContext ZTContext { get; set; }
    [Parameter]
    public TContainerModel Model { get; set; }
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    // ondrop事件处理方法
    private void HandleDrop(DragEventArgs e)
    {
        var dragingControlAttr = ZTContext.Designer.dragingControlAttr;
        if (dragingControlAttr == null)
            return;
        var newLocation = getMouseLocation_RelativeToCanvas(e);
        newLocation.X -= Model.Left;
        newLocation.Y -= Model.Top;
        addControl(dragingControlAttr, newLocation);
    }

    private Point getMouseLocation_RelativeToCanvas(MouseEventArgs e)
    {
        var x = e.OffsetX;
        var y = e.OffsetY;
        if (ZTContext.Designer.DesignScale != 100)
        {
            x /= ZTContext.Designer.DesignScale * 1D / 100;
            y /= ZTContext.Designer.DesignScale * 1D / 100;
        }
        return new Point(x, y);
    }

    //添加控件
    private void addControl(ControlAttribute controlAttr, Point location)
    {
        var control = controlAttr.CreateInstance();
        control.Left = location.X - control.Width / 2;
        control.Top = location.Y - control.Height / 2;
        ZTContext.Designer.CheckAndModifyControlName(control);
        control.OnDragDropCreate(location);
        ZTContext.Project.ApplyStyleShotcut(control);
        ZTContext.Designer.AddControl(control,Model);
    }
}