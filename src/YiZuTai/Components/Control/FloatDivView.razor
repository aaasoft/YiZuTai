@using YiZuTai.Control
@using YiZuTai.Core

@if (ControlModel.Visiable)
{
    <div id="floatDiv_@guid" style="
        left: @(ControlModel.Left)px;
        top: @(ControlModel.Top)px;
        width: @(ControlModel.Width)px;
        height: @(ControlModel.Height)px;
        opacity: @ControlModel.Opacity;
        position: absolute;
        " @attributes="DivAttributes">
        @ChildContent
    </div>
}

@code
{
    [Parameter]
    public ZTContext ZTContext { get; set; }
    [Parameter]
    public BaseControl ControlModel { get; set; }
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public Dictionary<string, object> DivAttributes { get; set; }

    private string guid = Guid.NewGuid().ToString("N");    
    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {
            if (!ControlModel.Visiable)
                return;
            ZTContext.JSRuntime.InvokeVoidAsync("eval",$@"
    let preRect=null;
    let resizeHandler = function(event){{
        let g = document.getElementById('svg_{ControlModel.Name}');
        let div = document.getElementById('floatDiv_{guid}');
        if(div==null) {{
            removeEventListener('resize', resizeHandler);
            return;
        }}
 
        let gRect = g.getBoundingClientRect();        
        let bodyRect = document.body.getBoundingClientRect();
        
        var gRectLeft=gRect.left-bodyRect.left;
        var gRectTop=gRect.top-bodyRect.top;
        var isChanged = preRect==null || preRect.left!=gRectLeft || preRect.top!=gRectTop || preRect.width!=gRect.width || preRect.height!=gRect.height;
        if(isChanged){{
            div.style.left = gRectLeft + 'px';
            div.style.top = gRectTop + 'px';
            div.style.width = gRect.width + 'px';
            div.style.height = gRect.height + 'px';
            preRect=gRect;
        }}
    }};
    if(document.readyState=='complete')
        resizeHandler();
    else
        addEventListener('load', resizeHandler);
    addEventListener('resize', resizeHandler);
");
        }
    }
}