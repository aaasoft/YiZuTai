@inherits EditorBase<bool?>
@code {
    private bool ValueForBind
    {
        get { return Value.Value; }
        set
        {
            Value = value;
        }
    }
    string id = "customSwitch_" + Guid.NewGuid().ToString("N");
}

@if (Value == null)
{
    <span class="form-control">(未设置)</span>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-secondary" @onclick="@(e => Value = true)">
            <i class="fa fa-plus" aria-hidden="true"></i>
        </button>
    </div>
}
else
{
    <div class="form-control">
        <div class="custom-control custom-switch">
            <InputCheckbox class="custom-control-input" @bind-Value="ValueForBind" id="@id" />
            <label class="custom-control-label" for="@id"></label>
        </div>
    </div>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-danger" @onclick="@(e => Value = null)"><i class="fa fa-trash"
                aria-hidden="true"></i></button>
    </div>
}