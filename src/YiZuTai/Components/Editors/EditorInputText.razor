@inherits EditorBase<string>

@if (Value == null)
{
    <span class="form-control" style="cursor: pointer;" @onclick="@(e => Value = string.Empty)">(未设置)</span>
}
else
{
    <InputText class="form-control" @bind-Value="Value"></InputText>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-danger" @onclick="@(e => Value = null)">
            <i class="fa fa-trash" aria-hidden="true"></i>
        </button>
    </div>
}