@inherits EditorBase<string>
@using YiZuTai.Model
@using YiZuTai.Utils
@using YiZuTai.Components

<ModalAlert @ref="modalAlert" />
<ModalWindow DialogSizeExtraLarge @ref="modalWindow" />

@if (string.IsNullOrEmpty(Value))
{
    <span class="form-control" style="cursor: pointer;" @onclick="onClick">(未设置)</span>
}
else
{
    <a class="form-control p-1" href="javascript:;" @onclick="onClick">
        <img class="w-100 h-100" src="@ZTFile.GetStaticResourceUrl(Value)" alt="@Value">
    </a>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-danger" @onclick="@(e=>Value=null)">
            <i class="fa fa-trash" aria-hidden="true"></i>
        </button>
    </div>
}
@code
{
    private ModalAlert modalAlert;
    private ModalWindow modalWindow;

    public static void Select(ModalWindow modalWindow,ZTFile ztFile,string value,Action<string> setValueAction)
    {
        modalWindow.Show<ImageSelectControl>("选择图片", new DialogParameters<ImageSelectControl>
        {
            { x => x.ZTFile, ztFile},
            { x => x.SelectedItem, value},
            { x => x.OkAction, value =>
                {
                    setValueAction( value);
                    modalWindow.Close();
                }
            }
        });
    }

    private void onClick()
    {
        Select(modalWindow,ZTFile, Value,t=>Value=t);
    }
}