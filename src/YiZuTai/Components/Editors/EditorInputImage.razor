@inherits EditorBase<string>
@using YiZuTai.Utils
@using YiZuTai.Components

<ModalAlert @ref="modalAlert" />
<ModalWindow DialogSizeExtraLarge @ref="modalWindow" />

@if (string.IsNullOrEmpty(Value))
{
    <a class="form-control p-1" href="javascript:;" @onclick="onClick">
    </a>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-secondary" @onclick="onClick">
            ...
        </button>
    </div>
}
else
{
    <a class="form-control p-1" href="javascript:;" @onclick="onClick">
        <img class="w-100 h-100" src="@Core.ZTFile.GetStaticResourceUrl(ZTFile.Id, Value)" alt="@Value">
    </a>
    <div class="input-group-append">
        <button type="button" class="btn btn-danger" @onclick="@(e=>Value=null)">
            X
        </button>
    </div>
}
@code
{
    private ModalAlert modalAlert;
    private ModalWindow modalWindow;

    public static void Select(ModalWindow modalWindow,Core.ZTFile ztFile,string value,Action<string> setValueAction)
    {
        modalWindow.Show<ImageSelectControl>("选择图片", new DialogParameters<ImageSelectControl>
        {
            { x => x.ZTFile, ztFile},
            { x => x.SelectedItem, value},
            { x => x.OkAction, value =>
                {
                    setValueAction( value);
                    modalWindow.Close();
                }
            }
        });
    }

    private void onClick()
    {
        Select(modalWindow,ZTFile, Value,t=>Value=t);
    }
}