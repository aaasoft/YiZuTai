<div class="row">
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <div class="btn-toolbar" role="toolbar">
                    <div class="btn-group mr-2" role="group">
                        <button type="button" class="btn btn-secondary" @onclick="btnAdd_Click">添加</button>
                    </div>
                    @if (SelectedItem != null)
                    {
                        <div class="btn-group mr-2" role="group">
                            <button type="button" class="btn btn-secondary" @onclick="btnMoveUp_Click">向上移动</button>
                        </div>
                        <div class="btn-group mr-2" role="group">
                            <button type="button" class="btn btn-secondary" @onclick="btnMoveDown_Click">向下移动</button>
                        </div>
                        <div class="btn-group mr-2" role="group">
                            <button type="button" class="btn btn-danger" @onclick="btnDelete_Click">删除</button>
                        </div>
                    }
                </div>
            </div>
             <ul class="list-group list-group-flush">                
                @foreach (var item in ValueList)
                {
                    @if (item == SelectedItem)
                    {
                        <li class="list-group-item active">@item</li>
                    }
                    else
                    {
                        <li class="list-group-item" @onclick=@(e => onItem_Click(item))>@item</li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                属性
            </div>
            @if (SelectedItem != null)
            {
                <PropertyGrid SelectedObject="SelectedItem" @bind-SelectedField="PropertyGridSelectedField"></PropertyGrid>
            }
        </div>
        @if (PropertyGridSelectedField != null)
        {
            <div class="card-footer">
                @if (PropertyGridSelectedField != null)
                {
                    <div class="card-title m-0 ml-2 mt-1 font-weight-bold">@PropertyGridSelectedField.Name</div>
                    if (!string.IsNullOrEmpty(PropertyGridSelectedField.Description))
                    {
                        @foreach (var line in PropertyGridSelectedField.Description.Split('\r', '\n'))
                        {
                            <small class="form-text text-muted">@line</small>
                        }
                    }
                }
            </div>
        }
    </div>
</div>