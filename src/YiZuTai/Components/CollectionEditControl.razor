<div class="row">
    <div class="col-5">
        <div class="card">
            <div class="card-header">
                项
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in ValueList)
                {
                    @if (item == SelectedItem)
                    {
                        <li class="list-group-item active">@item</li>
                    }
                    else
                    {
                        <li class="list-group-item" @onclick=@(e => onItem_Click(item))>@item</li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-secondary btn-block" @onclick="btnAdd_Click">+</button>
        @if (CanMoveUp)
        {
            <button type="button" class="btn btn-secondary btn-block" @onclick="btnMoveUp_Click">▲</button>
        }
        else
        {
            <button type="button" class="btn btn-secondary btn-block" disabled>▲</button>
        }
        @if (CanMoveDown)
        {
            <button type="button" class="btn btn-secondary btn-block" @onclick="btnMoveDown_Click">▼</button>
        }
        else
        {
            <button type="button" class="btn btn-secondary btn-block" disabled>▼</button>
        }
        @if (CanDelete)
        {
            <button type="button" class="btn btn-danger btn-block" @onclick="btnDelete_Click">X</button>
        }
        else
        {
            <button type="button" class="btn btn-danger btn-block" disabled>X</button>
        }
    </div>
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                属性
            </div>
            @if (SelectedItem != null)
            {
                <PropertyGrid SelectedObject="SelectedItem" @bind-SelectedField="PropertyGridSelectedField"></PropertyGrid>
            }
        </div>
        @if (PropertyGridSelectedField != null)
        {
            <div class="card-footer">
                @if (PropertyGridSelectedField != null)
                {
                    <div class="card-title m-0 ml-2 mt-1 font-weight-bold">@PropertyGridSelectedField.Name</div>
                    if (!string.IsNullOrEmpty(PropertyGridSelectedField.Description))
                    {
                        @foreach (var line in PropertyGridSelectedField.Description.Split('\r', '\n'))
                        {
                            <small class="form-text text-muted">@line</small>
                        }
                    }
                }
            </div>
        }
    </div>
</div>