<div class="form-group ml-2">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <div class="input-group">
                <div class="input-group-prepend">
                    <div class="input-group-text">分类</div>
                </div>
                <InputSelect class="form-control" @bind-Value="SelectedCategory">
                    @foreach (var item in SourceCategorys)
                    {
                        <option value="@item">@item</option>
                    }
                </InputSelect>
            </div>
        </div>
        <div class="col-auto">
            <div class="input-group">
                <div class="input-group-prepend">
                    <div class="input-group-text">源</div>
                </div>
                <InputSelect class="form-control" @bind-Value="SelectedSourceId">
                    <option value="">无</option>
                    @if (Sources != null)
                    {
                        @foreach (var item in Sources)
                        {
                            <option value="@item.GetType().FullName">@item.Name</option>
                        }
                    }
                </InputSelect>
            </div>
        </div>
        @if (Source != null)
        {
            <div class="col-auto">
                <button type="button" class="btn btn-secondary" @onclick="Copy">复制</button>
            </div>
        }
        <div class="col-auto">
            <button type="button" class="btn btn-secondary" @onclick="Paste">粘贴</button>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-secondary" @onclick="Ok">确定</button>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12 col-lg-8">
        <div class="form-group m-1">
            @if (Source != null)
            {
                <PropertyGrid SelectedObject="Source" @bind-SelectedField="PropertyGridSelectedField" />
            }
        </div>
    </div>
    <div class="col-12 col-lg-4" style="@PropertyGridSelectedFieldDescriptionStyle">
        @if (PropertyGridSelectedField != null)
        {
            <div class="alert alert-secondary" role="alert">
                <p class="alert-heading">@PropertyGridSelectedField.Name</p>
                @if (!string.IsNullOrEmpty(PropertyGridSelectedField.Description))
                {
                    @foreach (var line in PropertyGridSelectedField.Description.Split('\r', '\n'))
                    {
                        <small class="form-text text-muted">@line</small>
                    }
                }
            </div>
        }
    </div>
</div>

<ModalAlert @ref="modalAlert"></ModalAlert>