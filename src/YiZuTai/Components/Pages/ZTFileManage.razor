<ModalAlert @ref="modalAlert" />
<ModalWindow @ref="modalWindow" DialogSizeLarge />

<PageTitle>组态文件</PageTitle>
<div class="row">
    <div class="col-12">
        <nav class="navbar pr-1">
            <div class="navbar-brand">组态文件</div>
            <div class="btn-toolbar">
                <div class="input-group mr-2 mb-1">
                    <button type="button" class="btn btn-info" @onclick="CreateZTFile">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        新建
                    </button>
                </div>
                <EditForm Model="@this">
                    <div class="input-group mr-2 mb-1">
                        <div class="input-group-prepend">
                            <div class="input-group-text">标签</div>
                        </div>
                        <InputSelect class="form-control" @bind-Value="searchTag">
                            <option value="">全部</option>
                            @if (!Core.TagManager.Instance.IsEmpty())
                            {
                                @foreach (var tag in Core.TagManager.Instance.GetTags())
                                {
                                    <option value="@tag">@tag</option>
                                }
                            }
                        </InputSelect>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-primary" @onclick="ShowTagManager">
                                <i class="fa fa-ellipsis-h"></i>
                            </button>
                        </div>
                    </div>
                </EditForm>
                <div class="input-group mb-1">
                    <div class="input-group-prepend">
                        <div class="input-group-text">关键字</div>
                    </div>
                    <input type="text" class="form-control" @bind-value="searchKeywords">
                    <div class="input-group-append">
                        <button type="button" class="btn btn-primary">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</div>

<div class="row">
    @if (Core.ZTFileManager.Instance.IsEmpty())
    {
        <div class="col-12">
            <div class="alert alert-info mt-2" role="alert">
                空空如也，新建一个组态文件吧
            </div>
        </div>
    }
    else
    {
        @foreach (var t in Core.ZTFileManager.Instance.Query(searchTag, searchKeywords))
        {
            <div class="col-xl-4 col-lg-6 col-sm-12 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-file mr-1" aria-hidden="true"></i><span class="mr-2">@t.Name</span>
                        @if (t.Tags != null)
                        {
                            @foreach (var tag in t.Tags)
                            {
                                <span class="badge badge-pill badge-info mr-1">@tag</span>
                            }
                        }
                    </div>
                    @if(!string.IsNullOrEmpty(t.Description))
                    {
                        <div class="card-body">
                            @t.Description
                        </div>
                    }
                    <div class="card-footer p-1">
                        <div class="btn-group">
                            <button type="button" title="编辑" class="btn btn-sm btn-primary" @onclick="@(e => EditZTFile(t))">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </button>
                            <a href="YiZuTai/@(t.Id)/Design" target="_blank" title="设计" class="btn btn-sm btn-primary">
                                <i class="fa fa-tree" aria-hidden="true"></i>
                            </a>
                            <a href="YiZuTai/@(t.Id)/View" target="_blank" title="展示" class="btn btn-sm btn-primary">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </a>
                            <button type="button" title="删除" class="btn btn-sm btn-danger" @onclick="@(e => DeleteZTFile(t))">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>