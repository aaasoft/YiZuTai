<Quick.Blazor.Bootstrap.Admin.FileManageControl BaseDir="@baseDir" FileFilter="@FileFilter" @ref="fileManageControl">
    <ToolbarAddonButtons>
        @if (fileManageControl.SelectedPath != null && File.Exists(fileManageControl.SelectedPath))
        {
            <button title="选择" type="button" class="btn btn-sm btn-secondary" @onclick="btnSelect_Click">
                选择
            </button>
        }
    </ToolbarAddonButtons>
</Quick.Blazor.Bootstrap.Admin.FileManageControl>

<ModalAlert @ref="modalAlert"></ModalAlert>

@code
{
    private Quick.Blazor.Bootstrap.Admin.FileManageControl fileManageControl;
    [Parameter]
    public Core.ZTFile ZTFile { get; set; }
    [Parameter]
    public Action<string> OkAction { get; set; }
    [Parameter]
    public string FileFilter{get;set;}
    [Inject]
    private IJSRuntime JSRuntime { get; set; }
    private ModalAlert modalAlert;

    private string baseDir;

    protected override void OnParametersSet()
    {
        baseDir = ZTFile.ResourceFolder;
    }

    private void btnSelect_Click()
    {
        var fileInfo = new FileInfo(fileManageControl.SelectedPath);
        if (fileInfo == null)
            return;
        var path = fileInfo.FullName.Substring(baseDir.Length + 1);
        OkAction?.Invoke(path);        
    }
}