@using YiZuTai.Model
<Quick.Blazor.Bootstrap.Admin.FileManageControl BaseDir="@baseDir" @ref="fileManageControl">
    <ToolbarAddonButtons>
        @if (fileManageControl.IsSelectedFile())
        {
            <button title="预览" type="button" class="btn btn-sm btn-secondary" @onclick="btnPreview_Click">
                预览
            </button>
        }
    </ToolbarAddonButtons>
</Quick.Blazor.Bootstrap.Admin.FileManageControl>

<ModalAlert @ref="modalAlert"></ModalAlert>

@code
{
    private Quick.Blazor.Bootstrap.Admin.FileManageControl fileManageControl;
    [Parameter]
    public ZTFile ZTFile { get; set; }
    [Inject]
    private IJSRuntime JSRuntime { get; set; }
    private ModalAlert modalAlert;

    private string baseDir;

    protected override void OnParametersSet()
    {
        baseDir = ZTFile.ResourceFolder;
    }

    private void btnPreview_Click()
    {
        var url = ZTFile.GetStaticResourceUrl(fileManageControl.SelectedPath);
        JSRuntime.InvokeVoidAsync("eval", $@"
new YiZuTai.CreateWindow({{
    maxmin: true,
    pages: [{{
        title: '预览',
        url: '{url}'
    }}]
}}).show();");
    }
}