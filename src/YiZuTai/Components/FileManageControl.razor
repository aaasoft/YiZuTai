@using System.IO
@using Tewr.Blazor.FileReader
@inject IFileReaderService fileReaderService;

<ToastStack @ref="toastStack" />

<div class="row">
    <div class="col-12 p-0">
        <div class="btn-toolbar mb-1">
            <div class="btn-group mr-2">
                <button title="返回上层" type="button" class="btn btn-secondary" @onclick="btnGotoUpper_Click">
                    返回上层
                </button>
            </div>
            <div class="btn-group mr-2">
                <button title="创建文件夹" type="button" class="btn btn-secondary" @onclick="btnCreateFolder_Click">
                    创建文件夹
                </button>
                <div class="btn btn-secondary">
                    上传
                    <input @ref="inputFile" id="inputFile" type="file" style="width: 0px; visibility: collapse;" @onchange="onInputFileChanged">
                    <label title="上传" style="position: absolute;top: 0;left: 0;right:0;margin:0;height:100%;cursor:pointer" for="inputFile">
                    </label>
                </div>
            </div>
            <div class="btn-group mr-2">
                <button title="刷新" type="button" class="btn btn-secondary" @onclick="refresh">
                    刷新
                </button>
                @if (SelectedItem != null)
                {
                    <button title="重命名" type="button" class="btn btn-secondary" @onclick="btnRename_Click">
                        重命名
                    </button>
                    <button title="删除" type="button" class="btn btn-secondary" @onclick="btnDelete_Click">
                        删除
                    </button>
                }
                @if (SelectedItem != null && SelectedItem is FileInfo)
                {
                    <button title="下载" type="button" class="btn btn-secondary" @onclick="btnDownload_Click">
                        下载
                    </button>
                    <button title="预览" type="button" class="btn btn-secondary" @onclick="btnPreview_Click">
                        预览
                    </button>
                }
            </div>
        </div>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text">地址</span>
            </div>
            <input type="text" class="form-control col-auto" @bind-value="CurrentPath" />
            <div class="input-group-append">
                <button title="转到" type="button" class="btn btn-secondary" @onclick="btnGoto_Click">
                    转到
                </button>
            </div>
        </div>
    </div>
    <div class="card col-12 p-0 mt-2">
        <div class="card-body">
            <div class="row">
                @if (Dirs != null)
                {
                    @foreach (var dir in Dirs)
                    {
                        <div class="col-4 col-sm-3 col-md-2 col-xl-1 m-1 p-0" style="min-width:6.5rem;">
                            <a href="javascript:;" title="创建时间：@dir.CreationTime"
                       class="text-center list-group-item list-group-item-action border-0 p-0 @(SelectedItem == dir ? "active" : "")"
                       @onclick="@(e => SelectedItem = dir)" @ondblclick="@(e => gotoDir(dir))">
                                <p class="h1 m-0 pt-1"><i class="fa fa-folder" aria-hidden="true"></i></p>
                                <span class="text-center">@dir.Name</span>
                            </a>
                        </div>
                    }
                }
                @if (Files != null)
                {
                    @foreach (var file in Files)
                    {
                        <div class="col-4 col-sm-3 col-md-2 col-xl-1 m-1 p-0" style="min-width:6.5rem;">
                            <a href="javascript:;" title="大小：@(storageUSC.GetString(file.Length, 0, true))B
修改时间：@file.LastWriteTime"
                       class="text-center list-group-item list-group-item-action border-0 p-1 @(SelectedItem == file ? "active" : "")"
                       @onclick="@(e => SelectedItem = file)" @ondblclick="btnDownload_Click">
                                <p class="h1 m-0 pt-1"><i class="fa fa-file-o" aria-hidden="true"></i></p>
                                <span class="text-center">@file.Name</span>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<ModalLoading @ref="modalLoading" />
<ModalAlert @ref="modalAlert" />
<ModalPrompt @ref="modalPrompt" />