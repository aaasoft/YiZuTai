@using Microsoft.AspNetCore.Builder
@using YiZuTai.Control
@using YiZuTai.Core
@using YiZuTai.Core.Utils

<PageTitle>@title</PageTitle>
<HeadContent>
    <script src="_content/YiZuTai/jquery-1.12.4/jquery.min.js"></script>
    <script src="_content/YiZuTai/layer-3.1.1/layer.js"></script>
    <script src="_content/YiZuTai/js/core.js"></script>
    <script src="_content/YiZuTai/js/designer.js"></script>
    <style>
        text {
            user-select: none;
        }
        #divCanvas:focus{
            border-color: #80bdff;
            outline: 0;
            box-shadow: 0 0 0 .2rem rgba(0, 123, 255, .25);
        }
    </style>
</HeadContent>

@if (Model == null)
{
    <div class="alert alert-warning" role="alert">
        未找到编号为[@(Id)]的组态文件!
    </div>
}
else
{
    <CascadingValue Value="Model">
    <ToastStack @ref="toastStack" />
    
    <!--顶部菜单部分-->
    <div class="row">
        <div class="col-12 p-0 pt-1 pb-1">
            <Tabs IsNavPills NavTabsExtraClass="pb-1" TabContentExtraClass="p-2 border rounded">
                <TabPane Key="开始">
                    <Tab>开始</Tab>
                    <ChildContent>
                        <div class="btn-toolbar">
                            <div class="btn-group mr-1">
                                <button type="button" class="btn btn-secondary" title="保存" @onclick="Save">保存</button>
                                <button type="button" class="btn btn-secondary" title="预览" @onclick="Preview">预览</button>
                            </div>
                            <div class="btn-group mr-1">
                                <button type="button" class="btn btn-secondary" title="资源文件" @onclick="FileManage">资源文件</button>
                            </div>
                            <div class="btn-group mr-1">
                                <button type="button" class="btn btn-secondary" title="源码" @onclick="ShowSourceCode">源码</button>
                            </div>
                        </div>
                    </ChildContent>
                </TabPane>
                <TabPane Key="视图">
                    <Tab>视图</Tab>
                    <ChildContent>
                        <div class="btn-toolbar">
                            <div class="input-group mr-1">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">网格大小</div>
                                </div>
                                <input type="number" class="form-control" min="1" style="width:5rem;" @bind-value="Project.DesignGridSize">
                            </div>
                            <div class="input-group mr-1">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">显示比例</div>
                                </div>
                                <input type="number" class="form-control" min="10" step="10" style="width:5rem;" @bind-value="DesignScale">
                            </div>
                            <div class="custom-control custom-switch m-1 mr-2">
                                <input type="checkbox" @bind="ShowDesignGrid" class="custom-control-input" id="switchShowDesignGrid">
                                <label class="custom-control-label align-middle" for="switchShowDesignGrid">显示网格</label>
                            </div>
                            <div class="custom-control custom-switch m-1 mr-2">
                                <input type="checkbox" @bind="ShowToolBox" class="custom-control-input" id="switchShowToolBox">
                                <label class="custom-control-label align-middle" for="switchShowToolBox">工具箱</label>
                            </div>
                            <div class="custom-control custom-switch m-1 mr-2">
                                <input type="checkbox" @bind="ShowPropertyBox" class="custom-control-input" id="switchShowPropertyBox">
                                <label class="custom-control-label align-middle" for="switchShowPropertyBox">属性</label>
                            </div>
                        </div>
                    </ChildContent>
                </TabPane>
            </Tabs>
        </div>
    </div>
    <!--主要内容部分-->
    <div class="row">
        <div class="card-group w-100">
@if(ShowToolBox)
{
            <!--左侧工具箱部分-->
            <div class="card col-xl-2 col-lg-3 col-md-4 p-0">
                <div class="card-header" style="user-select: none;">
                    工具箱
                </div>
                <div id="divToolbox" class="card-body p-1 overflow-auto">
                    <Quick.Blazor.Bootstrap.Accordion AllowMultiplePanelActived="true">
                        @foreach (var group in ControlManager.Instance.GetItems().GroupBy(t => t.Category))
                        {    
                            <Quick.Blazor.Bootstrap.AccordionPane Key="@group.Key">
                                <Tab><b>@group.Key</b></Tab>
                                <TabCollpsed><i class="fa fa-caret-right"></i></TabCollpsed>
                                <TabExpand><i class="fa fa-caret-down"></i></TabExpand>
                                <ChildContent>
                                @foreach (var controlAttr in group)
                                {
                                    <div draggable="true" class="btn btn-light btn-block text-left p-1 m-0 mt-1"
                                        @ondragstart="@(e => HandleDragStart(e,controlAttr))">
                                        <img src="@controlAttr.Icon" style="width:1.5rem;height:1.5rem;" alt="@controlAttr.Name">
                                        <span>@controlAttr.Name</span>
                                    </div>
                                }
                                </ChildContent>
                            </Quick.Blazor.Bootstrap.AccordionPane>
                        }
                    </Quick.Blazor.Bootstrap.Accordion>
                </div>
            </div>
}
            <!--中间设计部分-->
            <div class="card col p-0" @onkeydown="onKeyDown" @onmouseup="onMouseUp">
                <ContextMenu Id="designMenu">
                    @if (IsSelectedControl)
                    {
                        <Item OnClick="@(e => setControlIndex(index => Project.Controls.Count, true))">置于顶层</Item>
                        <Item OnClick="@(e => setControlIndex(index => 0, true))">置于底层</Item>
                        <Item OnClick="@(e => setControlIndex(index => index + 1, true))">置于上一层</Item>
                        <Item OnClick="@(e => setControlIndex(index => index - 1, true))">置于下一层</Item>
                        <Seperator />
                        <Item OnClick="@copyControl">复制</Item>
                        <Item OnClick="@pasteControl">粘贴</Item>
                        <Item OnClick="@removeControl">删除</Item>
                    }
                    else
                    {
                        <Item OnClick="@Preview">预览</Item>
                        <Item OnClick="@pasteControl">粘贴</Item>                        
                    }
                </ContextMenu>
                <ContextMenuTrigger MenuId="designMenu">
                    <div id="divCanvas" tabindex="0" class="card-body text-center p-0 overflow-auto" style="background-color: @Project.Background;">
                        <!--====控件部分====-->
                    <svg id="svgCanvas" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xhtml="http://www.w3.org/1999/xhtml"
                            width="@(Project.Width*DesignScale/100)" height="@(Project.Height*DesignScale/100)"
                            viewBox="00 00 @Project.Width @Project.Height"
                            preserveAspectRatio="none"
                            onpointerdown="YiZuTai.Designer.SetPointerCapture(event)"
                            onpointerup="YiZuTai.Designer.ReleasePointerCapture(event)"
                            @onmousemove="onMouseMove"
                            ondragover="event.preventDefault();"
                            @ondrop="HandleDrop">
                            <!--====画布部分====-->
                        <g @onmousedown="onCanvasMouseDown">
                                <rect fill="@Project.Foreground" fill-opacity="@Project.ForegroundOpacity"
                                    rx="@Project.CornerRadius" ry="@Project.CornerRadius"
                                    stroke="@Project.Border" stroke-opacity="@Project.BorderOpacity" stroke-width="@Project.BorderThickness"
                                    x="0" y="0" width="@Project.Width" height="@Project.Height"></rect>
                                @if (!string.IsNullOrEmpty(Project.Image))
                                {
                                    <image href="@Core.ZTFile.GetStaticResourceUrl(Model.Id, Project.Image)" width="100%" height="100%" preserveAspectRatio="none"></image>
                                }
                                @if(ShowDesignGrid)
                                {
                                    @for (var x = 0; x <= Project.Width; x+=Project.DesignGridSize)
                                    {
                                        <line x1="@x" y1="0" x2="@x" y2="@Project.Height" stroke="@Project.DesignGridColor" stroke-opacity="0.5" />
                                    }
                                    @for (var y = 0; y <= Project.Height; y+=Project.DesignGridSize)
                                    {
                                        <line x1="0" y1="@y" x2="@Project.Width" y2="@y" stroke="@Project.DesignGridColor" stroke-opacity="0.5" />
                                    }
                                }
                            </g>
                            <!--====控件SVG部分====-->
                            @foreach (var Item in Project.Controls)
                            {
                                <g transform="rotate(@Item.Angle @Item.CenterPointLocation.X, @Item.CenterPointLocation.Y) translate(0, 0) scale(1)"
                            @onmousedown="@(e => onControlMouseDown(e,Item))"
                            @ondblclick="@(e=>Item.OnDoubleClick())">
                                    @Item.GetView(@ZTContext)
                                </g>
                            }
                            @if(IsSelectedControl)
                            {
                            <g transform="rotate(@SelectedItem.Angle @SelectedItem.CenterPointLocation.X, @SelectedItem.CenterPointLocation.Y) translate(0, 0) scale(1)"
                                @ondblclick="@(e=>SelectedItem.OnDoubleClick())">
                                <!--虚线框，用于移动控件位置-->
                            <rect fill-opacity="0" stroke="#0078D7" stroke-dasharray="4" stroke-width="1"
                                  x="@SelectedItem.Left" y="@SelectedItem.Top" width="@SelectedItem.Width" height="@SelectedItem.Height"
                                  style="@(SelectedItem.IsLocked?"cursor:not-allowed;":"cursor:move;")"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.MoveLocation))" />
                                @if (!SelectedItem.IsLocked)
                                {
                                    <!--旋转-->
                                    @if(SelectedItem is not MultiControl && SelectedItem.CanRotate)
                                    {
                                        <g>
                                            <line x1="@(SelectedItem.Left + SelectedItem.Width / 2)" y1="@(SelectedItem.Top - resize_box_width * 3)"
                                        x2="@(SelectedItem.Left + SelectedItem.Width / 2)" y2="@(SelectedItem.Top - resize_box_width * 3 + resize_box_width * 2)"
                                        stroke="#0078D7" stroke-dasharray="4" stroke-width="1" />
                                            <circle stroke="#0078D7" fill="#0078D7" fill-opacity="0.2" style="cursor: crosshair;"
                                            cx="@(SelectedItem.Left + SelectedItem.Width / 2)" cy="@(SelectedItem.Top - resize_box_width * 3 - resize_box_width / 2)" r="@(resize_box_width * 2 / 3)"
                                            @onmousedown="@(e => sizerMouseDown(e, MoveAction.Rotate))" />
                                        </g>
                                    }
                                    <!--左上角大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left - resize_box_width)" y="@(SelectedItem.Top - resize_box_width)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(315);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeLeftTop))"></rect>
                                    <!--上方大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left + (SelectedItem.Width - resize_box_width) / 2)" y="@(SelectedItem.Top - resize_box_width)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(0);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeTop))"></rect>
                                    <!--右上角大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left + SelectedItem.Width)" y="@(SelectedItem.Top - resize_box_width)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(45);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeRightTop))"></rect>
                                    <!--右侧大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left + SelectedItem.Width)" y="@(SelectedItem.Top + (SelectedItem.Height - resize_box_width) / 2)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(90);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeRight))"></rect>
                                    <!--右下角大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left + SelectedItem.Width)" y="@(SelectedItem.Top + SelectedItem.Height)" width="@resize_box_width" height="@resize_box_width"
                                  cursor="@getSizerCursor(135)"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeRightBottom))"></rect>
                                    <!--下方大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left + (SelectedItem.Width - resize_box_width) / 2)" y="@(SelectedItem.Top + SelectedItem.Height)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(180);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeBottom))"></rect>
                                    <!--左下角大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left - resize_box_width)" y="@(SelectedItem.Top + SelectedItem.Height)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(225);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeLeftBottom))"></rect>
                                    <!--左侧大小调整-->
                                    <rect fill-opacity="0" stroke="#0078D7" stroke-width="1"
                                  x="@(SelectedItem.Left - resize_box_width)" y="@(SelectedItem.Top + (SelectedItem.Height - resize_box_width) / 2)" width="@resize_box_width" height="@resize_box_width"
                                  style="cursor:@getSizerCursor(270);"
                                  @onmousedown="@(e => sizerMouseDown(e, MoveAction.ResizeLeft))"></rect>
                                }
                            </g>
                            }
                            @if(mouseDownControlMeta!=null && mouseDownControlMeta.MoveAction == MoveAction.Selecting)
                            {
                            <g>
                                
                                <rect x="@mouseDownControlMeta.MoveRect.X" y="@mouseDownControlMeta.MoveRect.Y"
                                    width="@mouseDownControlMeta.MoveRect.Width" height="@mouseDownControlMeta.MoveRect.Height" fill="#0078D7"
                                    fill-opacity="0.2" stroke="#0078D7" stroke-width="1"></rect>                                
                            </g>
                            }
                        </svg>
                    </div>
                </ContextMenuTrigger>
            </div>
@if(ShowPropertyBox)
{
            <!--右侧属性部分-->
            <div class="card col-xl-2 col-lg-3 col-md-4 p-0">
                <div class="card-header p-0" style="user-select: none;">
                    <EditForm Model="SelectedItem">
                        <div class="form-group m-1">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-text" style="user-select: none;">控件</div>
                                </div>
                                <InputSelect class="form-control" @bind-Value="SelectedItemName">
                                    <option value="">画布</option>
                                    @if(SelectedItem!=null && SelectedItem is MultiControl)
                                    {
                                        <option value="@SelectedItem.Name">@SelectedItem.Name</option>
                                    }
                                    @foreach (var item in Project.Controls)
                                    {
                                    <option value="@item.Name">@item.Name</option>
                                    }
                            </InputSelect>
                        </div>
                    </div>
                    </EditForm>
                </div>
                <div id="divProperty" class="card-body p-0 overflow-auto">
                    <EditForm Model="SelectedItem">
                        <PropertyGrid SelectedObject="SelectedItem" @bind-SelectedField="PropertyGridSelectedField"></PropertyGrid>
                    </EditForm>
                </div>
                <div id="divPropertyDescription" class="card-footer" style="@PropertyGridSelectedFieldDescriptionStyle">
                    @if (PropertyGridSelectedField!=null)
                    {
                        <div class="card-title m-0 ml-2 mt-1 font-weight-bold">@PropertyGridSelectedField.Name</div>                        
                        if(!string.IsNullOrEmpty(PropertyGridSelectedField.Description))
                        {
                            @foreach (var line in PropertyGridSelectedField.Description.Split('\r', '\n'))
                            {
                                <small class="form-text text-muted">@line</small>
                            }
                        }
                    }
                </div>
            </div>
}
        </div>
    </div>
    </CascadingValue>

    <ModalLoading @ref="modalLoading" />
    <ModalPrompt @ref="modalPrompt" />
    <ModalAlert @ref="modalAlert" />
    <ModalWindow DialogSizeExtraLarge @ref="modalWindow" />
}