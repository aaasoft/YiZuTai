@using Microsoft.AspNetCore.Builder
@using YiZuTai.Components.Control
@using YiZuTai.Control
@using YiZuTai.Core
@using YiZuTai.Enums

<PageTitle>@title</PageTitle>
<HeadContent>
    <base href="../../" />
    <script src="_content/YiZuTai/js/jquery-3.7.1.slim.min.js"></script>
    <script src="_content/YiZuTai/layer-3.1.1/layer.js"></script>
    <script src="_content/YiZuTai/js/core.js"></script>
    <script src="_content/YiZuTai/js/designer.js"></script>
    <style>
        text {
            user-select: none;
        }
        div.canvas:focus{
            border-color: #80bdff;
            outline: 0;
            box-shadow: 0 0 0 .2rem rgba(0, 123, 255, .25);
        }
    </style>
    @if(Project!=null)
    {
        @foreach(var jsFile in Project.GetAllReferenceJsFiles())
        {
            <script src="@jsFile"></script>
        }
    }
</HeadContent>

@if (ZTFile == null)
{
    <div class="alert alert-warning" role="alert">
        未找到编号为[@(Id)]的组态文件!
    </div>
}
else
{
    <ToastStack @ref="toastStack" />
    
    <!--顶部菜单部分-->
    <div class="row">
        <div class="col-12 p-0 pt-1 pb-1">
            <Tabs IsNavPills NavTabsExtraClass="pb-1" TabContentExtraClass="p-2 border rounded">
                <TabPane Key="开始">
                    <Tab>开始</Tab>
                    <ChildContent>
                        <div class="btn-toolbar">
                            <div class="btn-group mr-1">
                                <button type="button" class="btn btn-secondary" title="保存" @onclick="Save">保存</button>
                                <button type="button" class="btn btn-secondary" title="预览" @onclick="Preview">预览</button>
                            </div>
                            <div class="btn-group mr-1">
                                <button type="button" class="btn btn-secondary" title="文件" @onclick="FileManage">文件</button>
                                <button type="button" class="btn btn-secondary" title="源码" @onclick="ShowSourceCode">源码</button>
                            </div>
                            <div class="btn-group mr-1">
                                <button type="button" class="btn btn-secondary" title="剪贴板" @onclick="ShowClipboard">剪贴板</button>
                            </div>
                            <div class="input-group mr-1">
                                <div class="input-group-prepend">
                                    <div class="input-group-text" style="user-select: none;">样式</div>
                                </div>
                                <InputSelect class="form-control" @bind-Value="@StyleShotcut">
                                    <option value="样式-浅色">样式-浅色</option>
                                    <option value="样式-深色">样式-深色</option>
                                </InputSelect>
                            </div>
                            @if(IsSelectedMutiControl)
                            {
                                <div class="input-group mr-1">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text" style="user-select: none;">对齐</div>
                                    </div>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary" title="左" @onclick="(()=> ((MultiControl)SelectedItem).AlignToLeft())">左</button>
                                        <button type="button" class="btn btn-secondary" title="右" @onclick="(()=> ((MultiControl)SelectedItem).AlignToRight())">右</button>
                                        <button type="button" class="btn btn-secondary" title="上" @onclick="(()=> ((MultiControl)SelectedItem).AlignToTop())">上</button>
                                        <button type="button" class="btn btn-secondary" title="下" @onclick="(()=> ((MultiControl)SelectedItem).AlignToBottom())">下</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </ChildContent>
                </TabPane>
                <TabPane Key="视图">
                    <Tab>视图</Tab>
                    <ChildContent>
                        <div class="btn-toolbar">
                            <div class="input-group mr-1">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">网格大小</div>
                                </div>
                                <input type="number" class="form-control" min="1" style="width:5rem;" @bind-value="Project.DesignGridSize">
                            </div>
                            <div class="input-group mr-1">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">显示比例</div>
                                </div>
                                <input type="number" class="form-control" min="10" step="10" style="width:5rem;" @bind-value="DesignScale">
                            </div>
                            <div class="custom-control custom-switch m-1 mr-2">
                                <input type="checkbox" @bind="ShowDesignGrid" class="custom-control-input" id="switchShowDesignGrid">
                                <label class="custom-control-label align-middle" for="switchShowDesignGrid">显示网格</label>
                            </div>
                            <div class="custom-control custom-switch m-1 mr-2">
                                <input type="checkbox" @bind="ShowToolBox" class="custom-control-input" id="switchShowToolBox">
                                <label class="custom-control-label align-middle" for="switchShowToolBox">工具箱</label>
                            </div>
                            <div class="custom-control custom-switch m-1 mr-2">
                                <input type="checkbox" @bind="ShowPropertyBox" class="custom-control-input" id="switchShowPropertyBox">
                                <label class="custom-control-label align-middle" for="switchShowPropertyBox">属性</label>
                            </div>
                        </div>
                    </ChildContent>
                </TabPane>
            </Tabs>
        </div>
    </div>
    <!--主要内容部分-->
    <div class="row">
        <div class="card-group w-100">
@if(ShowToolBox)
{
            <!--左侧工具箱部分-->
            <div class="card col-xl-2 col-lg-3 col-md-4 p-0">
                <div class="card-header" style="user-select: none;">
                    工具箱
                </div>
                <div class="card-body p-1 overflow-auto" style="height: calc(100vh - 216px);">
                    <Quick.Blazor.Bootstrap.Accordion AllowMultiplePanelActived="true">
                        @foreach (var group in ControlManager.Instance.GetItems().GroupBy(t => t.Category))
                        {    
                            <Quick.Blazor.Bootstrap.AccordionPane Key="@group.Key">
                                <Tab><b>@group.Key</b></Tab>
                                <TabCollpsed><i class="fa fa-caret-right"></i></TabCollpsed>
                                <TabExpand><i class="fa fa-caret-down"></i></TabExpand>
                                <ChildContent>
                                @foreach (var controlAttr in group)
                                {
                                    <div draggable="true" class="btn btn-light btn-block text-left p-1 m-0 mt-1"
                                        @ondragstart="@(e => HandleDragStart(e,controlAttr))">
                                        <img src="@controlAttr.Icon" style="width:1.5rem;height:1.5rem;" alt="@controlAttr.Name">
                                        <span>@controlAttr.Name</span>
                                    </div>
                                }
                                </ChildContent>
                            </Quick.Blazor.Bootstrap.AccordionPane>
                        }
                    </Quick.Blazor.Bootstrap.Accordion>
                </div>
            </div>
}
            <!--中间设计部分-->
            <div class="card col p-0" @onkeydown="onKeyDown" @onkeydown:preventDefault @onmousemove="@(e=>{})">
                <ContextMenu Id="designMenu">
                    @if (IsSelectedControl)
                    {
                        @if(!IsSelectedMutiControl)
                        {
                            <Item OnClick="@(e => setControlIndex(index => Project.Controls.Count))">置于顶层</Item>
                            <Item OnClick="@(e => setControlIndex(index => 0))">置于底层</Item>
                            <Item OnClick="@(e => setControlIndex(index => index + 1))">置于上一层</Item>
                            <Item OnClick="@(e => setControlIndex(index => index - 1))">置于下一层</Item>
                            <Seperator />
                        }
                        <Item OnClick="@copyControl">复制</Item>
                        <Item OnClick="@pasteControl" Visible="@(ClipboardContent != null && ClipboardContent is BaseControl)">粘贴</Item>
                        <Item OnClick="@removeControl">删除</Item>
                    }
                    else
                    {
                        <Item OnClick="@Preview">预览</Item>
                        <Item OnClick="@pasteControl" Visible="@(ClipboardContent != null && ClipboardContent is BaseControl)">粘贴</Item>
                    }
                </ContextMenu>
                <ContextMenuTrigger MenuId="designMenu">
                    <div tabindex="0" class="canvas card-body text-center p-0 overflow-auto" style="background-color: @Project.BodyColor;align-content: center;height: calc(100vh - 120px);">
                        <!--====控件部分====-->
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xhtml="http://www.w3.org/1999/xhtml"
                            width="@(Project.Width*DesignScale/100)" height="@(Project.Height*DesignScale/100)"
                            viewBox="-@DesignMargin -@DesignMargin @(Project.Width + DesignMargin * 2) @(Project.Height + DesignMargin * 2)"
                            preserveAspectRatio="none">
                            <!--====画布部分====-->
                            <ContainerControlView TContainerModel="Project" ControlModel="Project" ZTContext="ZTContext">
                                @if (!string.IsNullOrEmpty(Project.Image))
                                {
                                    <image href="@ZTFile.GetStaticResourceUrl(Project.Image)" width="100%" height="100%" preserveAspectRatio="none"></image>
                                }
                                @if(ShowDesignGrid)
                                {
                                    @for (var x = 0; x <= Project.Width; x+=Project.DesignGridSize)
                                    {
                                        <line x1="@x" y1="0" x2="@x" y2="@Project.Height" stroke="@Project.DesignGridColor" stroke-opacity="0.5" />
                                    }
                                    @for (var y = 0; y <= Project.Height; y+=Project.DesignGridSize)
                                    {
                                        <line x1="0" y1="@y" x2="@Project.Width" y2="@y" stroke="@Project.DesignGridColor" stroke-opacity="0.5" />
                                    }
                                }                                
                            </ContainerControlView>
                        </svg>
                    </div>
                </ContextMenuTrigger>
            </div>
@if(ShowPropertyBox)
{
            <!--右侧属性部分-->
            <div class="card col-xl-2 col-lg-3 col-md-4 p-0">
                <div class="card-header p-0" style="user-select: none;">
                    <EditForm Model="SelectedItem">
                        <div class="form-group m-1">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-text" style="user-select: none;">控件</div>
                                </div>
                                <InputSelect class="form-control" @bind-Value="SelectedItemName">
                                    <option value="">画布</option>
                                    @if(IsSelectedMutiControl)
                                    {
                                        <option value="@SelectedItem.Name">@SelectedItem.Name</option>
                                    }
                                    @foreach (var item in Project.Controls)
                                    {
                                        <BaseControlSelectOptionView Model="item"></BaseControlSelectOptionView>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </EditForm>
                </div>
                <div class="card-body p-0 mt-1">
                    <Tabs>
                        <TabPane Key="property">
                            <Tab>属性</Tab>
                            <ChildContent>
                                <div class="overflow-auto mt-1" style="height: calc(100vh - 216px);">
                                    <CascadingValue Value="this">
                                        <CascadingValue Value="ZTFile">
                                            <EditForm Model="SelectedItem">
                                                <PropertyGrid SelectedObject="SelectedItem"></PropertyGrid>
                                            </EditForm>
                                        </CascadingValue>
                                    </CascadingValue>
                                </div>
                            </ChildContent>
                        </TabPane>
                        <TabPane Key="shotcut">
                            <Tab>快捷</Tab>
                            <ChildContent>
                                <div class="overflow-auto p-1" style="height: calc(100vh - 216px);">
                                    @foreach(var shotcut in ControlManager.Instance.GetControlShotcuts(SelectedItem))
                                    {
                                        <button type="button" class="btn btn-secondary btn-block" @onclick="@(e=>executeShotcut(shotcut))">@shotcut.Name</button>
                                    }
                                </div>
                            </ChildContent>
                        </TabPane>
                    </Tabs>                    
                </div>
            </div>
}
        </div>
    </div>

    <ModalWindow DialogSizeExtraLarge @ref="modalWindow" />
    <ModalAlert @ref="modalAlert" />
}