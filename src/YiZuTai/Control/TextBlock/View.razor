<YiZuTai.Design.BaseControl_WithBackgroundAndAnimateView @ref="baseControlView" Model="Model">
      <!--文本部分-->
      <g>
            <text fill="@Model.Foreground" x="@Model.TextX" y="@Model.TextY" font-size="@Model.FontSize"
                  font-weight="@Model.FontWeight" font-family="@Model.FontFamily" text-anchor="@Model.TextAnchor"
                  xml:space="preserve">@Model.Text</text>
      </g>
</YiZuTai.Design.BaseControl_WithBackgroundAndAnimateView>