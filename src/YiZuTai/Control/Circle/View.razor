<svg version="1.0" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     x="@Model.Left" y="@Model.Top" width="@Model.Width" height="@Model.Height" opacity="@Model.Opacity"
     visibility="@(Model.Visiable?"visible":"hidden")">
    <circle fill="@Model.Background" fill-opacity="@Model.BackgroundOpacity"
            stroke="@Model.Border" stroke-opacity="@Model.BorderOpacity" stroke-width="@Model.BorderThickness"
            cx="@cx" cy="@cy" r="@r" />
</svg>