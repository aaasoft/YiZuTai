@using YiZuTai.Core

<PageTitle>组态文件</PageTitle>
<div class="row">
    <div class="col-12">
        <nav class="navbar pr-1">
            <div class="navbar-brand">组态文件</div>
            <div class="btn-toolbar">
                <div class="input-group mr-2 mb-1">
                    <button type="button" class="btn btn-secondary" @onclick="CreateZTFile">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        新建
                    </button>
                    <button type="button" class="btn btn-secondary ml-2" @onclick="Import">
                        <i class="fa fa-upload" aria-hidden="true"></i>
                        导入
                    </button>
                </div>
                <div class="input-group mb-1">
                    <div class="input-group-prepend">
                        <div class="input-group-text">关键字</div>
                    </div>
                    <input type="text" class="form-control" @bind-value="searchKeywords">
                    <div class="input-group-append">
                        <button type="button" class="btn btn-secondary">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</div>

<div class="row">
    @if (ZTFileManager.Instance.IsEmpty())
    {
        <div class="col-12">
            <div class="alert alert-secondary mt-2" role="alert">
                空空如也，新建一个组态文件吧
            </div>
        </div>
    }
    else
    {
        @foreach (var t in ZTFileManager.Instance.Query(searchKeywords))
        {
            <div class="col-xl-4 col-lg-6 col-sm-12 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-file mr-1" aria-hidden="true"></i><span class="mr-2">@t.Name</span>
                    </div>
                    <div class="card-body">
                        @t.Description
                    </div>
                    <div class="card-footer p-1">
                        <div class="btn-group">
                            <a title="导出" class="btn btn-sm btn-secondary" target="_blank"
                                href="@(YiZuTaiMiddlewareExtensions.GetUrlWithPrefix($"/{t.Id}/Export"))">
                                <i class="fa fa-download" aria-hidden="true"></i>
                            </a>
                            <button type="button" title="编辑" class="btn btn-sm btn-secondary" @onclick="@(e => EditZTFile(t))">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </button>
                            <button type="button" title="删除" class="btn btn-sm btn-secondary"
                                @onclick="@(e => DeleteZTFile(t))">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="btn-group">
                            <a href="@(YiZuTaiMiddlewareExtensions.GetUrlWithPrefix($"/{t.Id}/Design"))" target="_blank"
                                title="设计" class="btn btn-sm btn-secondary">
                                <i class="fa fa-tree" aria-hidden="true"></i>
                            </a>
                            <a href="@(YiZuTaiMiddlewareExtensions.GetUrlWithPrefix($"/{t.Id}/View"))" target="_blank"
                                title="展示" class="btn btn-sm btn-secondary">
                                <i class="fa fa-search" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<ModalWindow @ref="modalWindow" DialogSizeLarge />
<ModalAlert @ref="modalAlert" />