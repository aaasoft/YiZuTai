@using YiZuTai.Core
@using YiZuTai.Model

<PageTitle>组态文件</PageTitle>
<HeadContent>
    <style>
        .treeview span.indent {
            margin-left: 1rem;
            margin-right: 1rem;
        }

        .treeview .list-group-item {
            cursor: pointer;
        }
    </style>
</HeadContent>

<div class="row">
    <div class="col-3">
        <div class="card">
            <div class="card-header">
                分组
            </div>
            <div class="card-body p-0">
                <div class="btn-toolbar p-1" role="toolbar">
                    <div class="btn-group mr-2" role="group">
                        <button type="button" class="btn btn-secondary" @onclick="createRootGroup">添加根</button>
                        @if (SelectedGroup == null)
                        {
                            <button type="button" class="btn btn-secondary" disabled>添加</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary" @onclick="createChildGroup">添加</button>
                        }
                    </div>
                    <div class="btn-group" role="group">
                        @if (SelectedGroup == null)
                        {
                            <button type="button" class="btn btn-secondary" disabled>编辑</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary" @onclick="editGroup">编辑</button>
                        }
                        @if (IsGroupCanDelete)
                        {
                            <button type="button" class="btn btn-secondary" @onclick="deleteGroup">删除</button>                        
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary" disabled>删除</button>
                        }
                    </div>
                </div>
                <div class="p-1">
                    <Tree DataSource="RootGroups" SelectedNodeChanged="onSelectedGroupChanged" ShowIcon
                        TitleExpression="x=>((GroupData)x.DataItem).Title" ChildrenExpression="GetGroupChildren"
                        IconExpression="x=> ((GroupData)x.DataItem).Icon" IsLeafExpression="x=>false" />
                </div>
            </div>
        </div>
    </div>
    @if (SelectedGroup != null)
    {
        <div class="col-9">
            <div class="card">
                <div class="card-header">
                    文件
                </div>
                <div class="card-body p-0">
                    <div class="btn-toolbar p-1">
                        <div class="btn-group mr-2 mb-1" role="group">
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="CreateZTFile">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                                新建
                            </button>
                        </div>
                        <div class="btn-group mr-2 mb-1" role="group">
                            <div class="btn btn-sm btn-secondary">
                                <i class="fa fa-upload" aria-hidden="true"></i> 上传
                                <input @ref="inputYztFile" id="inputRuntimeFile" type="file" accept=".yzt" style="width: 0px; height: 0px; visibility: collapse;" @onchange="@(e=>onInputYrtFileChanged())">
                                <label title="上传" style="position: absolute;top: 0;left: 0;right:0;margin:0;height:100%;cursor:pointer" for="inputRuntimeFile">
                                </label>
                            </div>
                        </div>
                        <div class="input-group mb-1">
                            <div class="input-group-prepend">
                                <div class="input-group-text">关键字</div>
                            </div>
                            <input type="text" class="form-control" @bind-value="searchKeywords">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-secondary">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row p-1">
                    @if (ZTFileManager.Instance.IsEmpty())
                    {
                        <div class="col-12">
                            <div class="alert alert-secondary mt-2" role="alert">
                                空空如也，新建一个组态文件吧
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var t in ZTFileManager.Instance.Query(SelectedGroup.Model.Id, searchKeywords))
                        {
                            <div class="col-xl-4 col-lg-6 col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <i class="fa fa-file mr-1" aria-hidden="true"></i><span class="mr-2">@t.Name</span>
                                    </div>
                                    <div class="card-body">
                                        @t.Description
                                    </div>
                                    <div class="card-footer p-1">
                                        <div class="btn-group">
                                            <a title="下载" class="btn btn-sm btn-secondary" target="_blank"
                                                href="@(YiZuTaiMiddlewareExtensions.GetUrlWithPrefix($"/{t.Id}/Download"))">
                                                <i class="fa fa-download" aria-hidden="true"></i>
                                            </a>
                                            <button type="button" title="编辑" class="btn btn-sm btn-secondary"
                                                @onclick="@(e => EditZTFile(t))">
                                                <i class="fa fa-pencil" aria-hidden="true"></i>
                                            </button>
                                            <button type="button" title="删除" class="btn btn-sm btn-secondary"
                                                @onclick="@(e => DeleteZTFile(t))">
                                                <i class="fa fa-trash" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <div class="btn-group">
                                            <a href="@(YiZuTaiMiddlewareExtensions.GetUrlWithPrefix($"/{t.Id}/Design"))" target="_blank"
                                                title="设计" class="btn btn-sm btn-secondary">
                                                <i class="fa fa-tree" aria-hidden="true"></i>
                                            </a>
                                            <a href="@(YiZuTaiMiddlewareExtensions.GetUrlWithPrefix($"/{t.Id}/View"))" target="_blank"
                                                title="展示" class="btn btn-sm btn-secondary">
                                                <i class="fa fa-search" aria-hidden="true"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<ModalWindow @ref="modalWindow" DialogSizeLarge />
<ModalLoading @ref="modalLoading" />
<ModalPrompt @ref="modalPrompt" />
<ModalAlert @ref="modalAlert" />