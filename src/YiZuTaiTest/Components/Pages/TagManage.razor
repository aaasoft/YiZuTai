@using YiZuTai.Core
<ModalAlert @ref="modalAlert" />
<ModalPrompt @ref="modalPrompt" />

<div class="row">
    <div class="col-12">
        <nav class="navbar pr-1">
            <div class="navbar-brand">标签管理</div>
            <div class="btn-toolbar">
                <div class="btn-group">
                    <button type="button" class="btn btn-info" @onclick="CreateTag">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        新建
                    </button>
                </div>
            </div>
        </nav>
    </div>
</div>

<div class="row">
    @if (TagManager.Instance.IsEmpty())
    {
        <div class="col-12">
            <div class="alert alert-info mt-2" role="alert">
                空空如也，新建一个标签吧
            </div>
        </div>
    }
    else
    {
        @foreach (var t in TagManager.Instance.GetTags())
        {
            <div class="col-4 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-tag mr-1" aria-hidden="true"></i>@t
                    </div>
                    <div class="card-footer p-1">
                        <div class="btn-group">
                            <button type="button" title="向左移动" class="btn btn-sm btn-primary" @onclick="@(e=>MoveLeft(t))">
                                <i class="fa fa-chevron-left" aria-hidden="true"></i>
                            </button>
                            <button type="button" title="向右移动" class="btn btn-sm btn-primary" @onclick="@(e=>MoveRight(t))">
                                <i class="fa fa-chevron-right" aria-hidden="true"></i>
                            </button>
                            <button type="button" title="删除" class="btn btn-sm btn-danger" @onclick="@(e=>DeleteTag(t))">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>