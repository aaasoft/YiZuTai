<div class="row">
    <div class="col-12">
        <EditForm Model="@createZTFileModel" OnValidSubmit="Ok">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>名称</label>
                <InputText class="form-control" @bind-Value="createZTFileModel.Name" />
                <ValidationMessage For="@(() => createZTFileModel.Name)" />
            </div>
            <div class="form-group">
                <label>描述</label>
                <InputTextArea class="form-control" @bind-Value="createZTFileModel.Description" />
                <ValidationMessage For="@(() => createZTFileModel.Description)" />
            </div>
            <button type="submit" class="btn btn-primary col-sm-5 col-md-4 col-lg-2">确定</button>
        </EditForm>
    </div>
</div>