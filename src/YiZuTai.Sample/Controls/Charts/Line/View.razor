@using System.Text.Json.Nodes
@using Newtonsoft.Json
@using System.Text
@using YiZuTai.Sample.Utils
@inherits AbstractControlView<Model>
@implements IDisposable

<BaseControl_WithBackgroundView T_BaseControl_WithBackground="Model" Model="@ControlModel" ZTContext="ZTContext">
</BaseControl_WithBackgroundView>

@code
{
    private void setDataSourceValue(int seriesIndex, string value)
    {
        var js = $@"let chart = document.getElementById('svg_{ControlModel.Name}').chart;

let currentSerie = chart.series[{seriesIndex}];

let time = {DateUtils.ToUnixTimestamp_ms(DateTime.Now)};
let numberValue = parseFloat('{value}');

while (currentSerie.data.length >= {ControlModel.SeriesDataMaxCount}) {{
    currentSerie.removePoint(0, false, false);
}}
currentSerie.addPoint([time, numberValue], true, false, false);";
        ZTContext.JSRuntime.InvokeVoidAsync("eval", js);
        //ZTContext.JSRuntime.InvokeVoidAsync("console.log", js);
    }

    private void setQueryDataSourceValue(int seriesIndex, QueryDataSourceResult[] value)
    {
        var valueJson = string.Join(',',value.Select(t=>$"{{time: {t.Time},x:'{t.X}',y:'{t.Y}'}}"));
        var js = $@"let chart = document.getElementById('svg_{ControlModel.Name}').chart;
let value = [{valueJson}];
let currentSerie = chart.series[{seriesIndex}];
currentSerie.setData([]);
        for (var i = 0; i < value.length; i++) {{
            var item = value[i];
            var x = item.x;
            switch ('{ControlModel.XAxisType}') {{
                case 'linear':
                    x = parseFloat(x);
                    break;
                case 'datetime':
                    x = item.time;
                    break;
            }}
            currentSerie.addPoint([x, parseFloat(item.y)], true, false, false);
        }}";
        ZTContext.JSRuntime.InvokeVoidAsync("eval", js);
        //ZTContext.JSRuntime.InvokeVoidAsync("console.log", js);
    }

    private void InitChart()
    {
        //初始化图表
        var js = $@"let chart = document.getElementById('svg_{ControlModel.Name}').chart;
if(typeof chart != 'undefined')
    chart.destroy();
document.getElementById('svg_{ControlModel.Name}').chart = Highcharts.chart('svg_{ControlModel.Name}',{{
    credits: {ControlModel.GetCreditsOptions()},
    chart: {ControlModel.GetChartOptions()},
    colors: {ControlModel.GetColorsOptions()},
    title: {ControlModel.GetTitleOptions()},
    xAxis: {ControlModel.GetXAxisOptions(false)},
    yAxis: {ControlModel.GetYAxisOptions()},
    tooltip: {ControlModel.GetTooltipOptions()},
    normalizeHandler: {ControlModel.GetNormalizeHandlerOptions(ZTContext.Project)},
    legend: {ControlModel.GetLegendOptions()},
    plotOptions: {ControlModel.GetPlotOptions()},
    series: {ControlModel.GetSeriesOptions()}
}})";
        ZTContext.JSRuntime.InvokeVoidAsync("eval", js.ToString());
        //ZTContext.JSRuntime.InvokeVoidAsync("console.log", js.ToString());

        //设置背景色
        ZTContext.JSRuntime.InvokeVoidAsync("eval", $@"
let backElement = jQuery('#svg_{ControlModel.Name} .highcharts-background');
backElement.attr('fill', '{ControlModel.Background}');
backElement.attr('fill-opacity', '{ControlModel.BackgroundOpacity}');
");
        //第一次显示数据
        for (var seriesIndex = 0; seriesIndex < ControlModel.SeriesData.Count; seriesIndex++)
        {
            var seriesData = ControlModel.SeriesData[seriesIndex];
            //如果是配置单条数据源
            if(seriesData.DataSource!=null)
            {
                var dataSource = seriesData.DataSource;
                if (dataSource == null)
                    continue;
                setDataSourceValue(seriesIndex, dataSource.Value);
            }
            //如果是配置多条数据源
            else
            {
                var dataSource = seriesData.QueryDataSource;
                if (dataSource == null)
                    continue;
                var value = dataSource.Value;
                if(value!=null)
                    setQueryDataSourceValue(seriesIndex, dataSource.Value);
            }
        }
    }

    private Timer checkControlSizeTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            InitChart();
            //注册数据源
            for (var seriesIndex = 0; seriesIndex < ControlModel.SeriesData.Count; seriesIndex++)
            {
                var seriesData = ControlModel.SeriesData[seriesIndex];
                //如果是配置单条数据源
                if(seriesData.DataSource!=null)
                {
                    var dataSource = seriesData.DataSource;
                    if (dataSource == null)
                        continue;

                    var currentSeriesIndex = seriesIndex;
                    dataSource.PropertyChanged += (sender, e) => setDataSourceValue(currentSeriesIndex, dataSource.Value);
                }
                //如果是配置多条数据源
                else
                {
                    var dataSource = seriesData.QueryDataSource;
                    if (dataSource == null)
                        continue;
                    setQueryDataSourceValue(seriesIndex, dataSource.Value);
                }
            }
            ControlModel.PropertyChanged += (sender,e)=>
            {
                switch(e.PropertyName)
                {
                    case nameof(Model.Left):
                    case nameof(Model.Top):
                    case nameof(Model.Width):
                    case nameof(Model.Height):
                    case nameof(Model.Angle):
                    case nameof(Model.Opacity):
                    case nameof(Model.IsLocked):
                    case nameof(Model.Visiable):
                        return;
                }
                InitChart();
            };
            if(ZTContext.DesignMode)
            {
                var preWidth = ControlModel.Width;
                var preHeight = ControlModel.Height;
                checkControlSizeTimer = new Timer(t=>
                {
                    if(preWidth == ControlModel.Width
                     && preHeight == ControlModel.Height)
                        return;
                        
                    preWidth = ControlModel.Width;
                    preHeight = ControlModel.Height;
                    InitChart();
                },null,1000,1000);
            }
        }
    }
    
    public void Dispose()
    {
        checkControlSizeTimer?.Dispose();
        checkControlSizeTimer=null;
    }
}