@using System.Text.Json.Nodes
@using Newtonsoft.Json
@using System.Text
@inherits AbstractControlView<Model>
@implements IDisposable

<BaseControl_WithBackgroundView T_BaseControl_WithBackground="Model" Model="@ControlModel" ZTContext="ZTContext">
</BaseControl_WithBackgroundView>

@code
{
    private void setValue(int seriesIndex, int itemIndex, string value)
    {
        var js = $@"let chart = document.getElementById('svg_{ControlModel.Name}').chart;
let numberValue = parseFloat('{value}');
let data = chart.series[{seriesIndex}].data;
data[{itemIndex}].y = numberValue;
chart.series[{seriesIndex}].setData(data);";
        ZTContext.JSRuntime.InvokeVoidAsync("eval", js);
        //ZTContext.JSRuntime.InvokeVoidAsync("console.log", js);
    }

    private void InitChart()
    {
        //初始化图表
        var sb = new StringBuilder();
        sb.AppendLine($"document.getElementById('svg_{ControlModel.Name}').chart = Highcharts.chart('svg_{ControlModel.Name}',{{");
        sb.AppendLine($@" credits: {ControlModel.GetCreditsOptions()},");
        sb.AppendLine($@" chart: {ControlModel.GetChartOptions()},");
        sb.AppendLine($@" colors: {ControlModel.GetColorsOptions()},");
        sb.AppendLine($@" title: {ControlModel.GetTitleOptions()},");
        sb.AppendLine($@" xAxis: {ControlModel.GetXAxisOptions()},");
        sb.AppendLine($@" yAxis: {ControlModel.GetYAxisOptions()},");
        sb.AppendLine($@" tooltip: {ControlModel.GetTooltipOptions()},");
        sb.AppendLine($@" normalizeHandler: {ControlModel.GetNormalizeHandlerOptions(ZTContext.Project)},");
        sb.AppendLine($@" legend: {ControlModel.GetLegendOptions()},");
        sb.AppendLine($@" plotOptions: {ControlModel.GetPlotOptions()},");
        sb.AppendLine($@" series: {ControlModel.GetSeriesOptions()}");
        sb.AppendLine($@"}})");
        ZTContext.JSRuntime.InvokeVoidAsync("eval", sb.ToString());
        ZTContext.JSRuntime.InvokeVoidAsync("console.log", sb.ToString());

        //设置背景色
        ZTContext.JSRuntime.InvokeVoidAsync("eval", $@"
let backElement = jQuery('#svg_{ControlModel.Name} .highcharts-background');
backElement.attr('fill', '{ControlModel.Background}');
backElement.attr('fill-opacity', '{ControlModel.BackgroundOpacity}');
");
        //第一次显示数据
        for (var itemIndex = 0; itemIndex < ControlModel.SeriesData.Count; itemIndex++)
        {
            var item = ControlModel.SeriesData[itemIndex];
            var dataSource = item.DataSource;
            if (dataSource == null)
                continue;
            setValue(0, itemIndex, dataSource.Value);
        }
    }

    private Timer checkControlSizeTimer;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            InitChart();
            //注册数据源
            for (var itemIndex = 0; itemIndex < ControlModel.SeriesData.Count; itemIndex++)
            {
                var item = ControlModel.SeriesData[itemIndex];
                var dataSource = item.DataSource;
                if (dataSource == null)
                    continue;

                var currentSeriesIndex = 0;
                var currentItemIndex = itemIndex;
                item.DataSource.PropertyChanged += (sender, e) => setValue(currentSeriesIndex, currentItemIndex, dataSource.Value);
            }
            ControlModel.PropertyChanged += (sender,e)=>
            {
                switch(e.PropertyName)
                {
                    case nameof(Model.Left):
                    case nameof(Model.Top):
                    case nameof(Model.Width):
                    case nameof(Model.Height):
                    case nameof(Model.Angle):
                    case nameof(Model.Opacity):
                    case nameof(Model.IsLocked):
                    case nameof(Model.Visiable):
                        return;
                }
                InitChart();
            };
            if(ZTContext.DesignMode)
            {
                var preWidth = ControlModel.Width;
                var preHeight = ControlModel.Height;
                checkControlSizeTimer = new Timer(t=>
                {
                    if(preWidth == ControlModel.Width
                     && preHeight == ControlModel.Height)
                        return;
                        
                    preWidth = ControlModel.Width;
                    preHeight = ControlModel.Height;
                    InitChart();
                },null,1000,1000);
            }
        }
    }
    
    public void Dispose()
    {
        checkControlSizeTimer?.Dispose();
        checkControlSizeTimer=null;
    }
}