@using System.Text.Json.Nodes
@inherits AbstractControlView<Model>

<BaseControl_WithBackgroundView T_BaseControl_WithBackground="Model" Model="@ControlModel"
    ZTContext="ZTContext">
</BaseControl_WithBackgroundView>

@code
{
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if(firstRender)
        {
            var options = new JsonObject(
                new Dictionary<string,JsonNode>()
                {
                    ["chart"] = ControlModel.GetChartOptions()
                }                
            );
            ZTContext.JSRuntime.InvokeVoidAsync("Highcharts.chart",$"svg_{ControlModel.Name}", options);
        }
    }
}