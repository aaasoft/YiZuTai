@using System.Text.Json.Nodes
@using Newtonsoft.Json
@using System.Text
@inherits AbstractControlView<Model>

<BaseControl_WithBackgroundView T_BaseControl_WithBackground="Model" Model="@ControlModel" ZTContext="ZTContext">
</BaseControl_WithBackgroundView>

@code
{
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            //初始化图表
            var sb = new StringBuilder();
            sb.AppendLine($@"document.getElementById('svg_{ControlModel.Name}').chart = Highcharts.chart('svg_{ControlModel.Name}',{{");
            sb.AppendLine($@" credits: {ControlModel.GetCreditsOptions()},");
            sb.AppendLine($@" chart: {ControlModel.GetChartOptions()},");
            sb.AppendLine($@" colors: {ControlModel.GetColorsOptions()},");
            sb.AppendLine($@" title: {ControlModel.GetTitleOptions()},");
            sb.AppendLine($@" xAxis: {ControlModel.GetXAxisOptions()},");
            sb.AppendLine($@" yAxis: {ControlModel.GetYAxisOptions()},");
            sb.AppendLine($@" tooltip: {ControlModel.GetTooltipOptions()},");
            sb.AppendLine($@" normalizeHandler: {ControlModel.GetNormalizeHandlerOptions(ZTContext.Project)},");
            sb.AppendLine($@" legend: {ControlModel.GetLegendOptions()},");
            sb.AppendLine($@" plotOptions: {ControlModel.GetPlotOptions()},");
            sb.AppendLine($@" series: {ControlModel.GetSeriesOptions()}");
            sb.AppendLine($@"}})");
            //ZTContext.JSRuntime.InvokeVoidAsync("console.log", sb.ToString());
            ZTContext.JSRuntime.InvokeVoidAsync("eval", sb.ToString());

            //设置背景色
            ZTContext.JSRuntime.InvokeVoidAsync("eval", $@"
let backElement = jQuery('#svg_{ControlModel.Name} .highcharts-background');
backElement.attr('fill', '{ControlModel.Background}');
backElement.attr('fill-opacity', '{ControlModel.BackgroundOpacity}');
");
            for (var seriesIndex = 0; seriesIndex < ControlModel.SeriesData2.Count; seriesIndex++)
            {
                var seriesData = ControlModel.SeriesData2[seriesIndex];
                for (var itemIndex = 0; itemIndex < seriesData.Items.Count; itemIndex++)
                {
                    var item =seriesData.Items[itemIndex];

                    var currentSeriesIndex = seriesIndex;
                    var currentItemIndex = itemIndex;
                    item.DataSource.PropertyChanged += (sender,e)=>
                    {
                        var js = $@"let chart = document.getElementById('svg_{ControlModel.Name}').chart;
                        let numberValue = parseFloat('{item.DataSource.Value}');
let data = chart.series[{currentSeriesIndex}].data;
data[{currentItemIndex}].y = numberValue;
chart.series[{currentSeriesIndex}].setData(data);";
                        ZTContext.JSRuntime.InvokeVoidAsync("eval", js);
                        //ZTContext.JSRuntime.InvokeVoidAsync("console.log", js);
                    };
                }
            }
        }
    }
}