@inherits AbstractControlView<Model>

@if(ControlModel.Visiable)
{
<div id="div_@guid"
    style="
    left: @(ControlModel.Left)px;
    top: @(ControlModel.Top)px;
    width: @(ControlModel.Width)px;
    height: @(ControlModel.Height)px;
    opacity: @ControlModel.Opacity;
    transform: scale(@(1/ControlModel.Zoom)) rotate(@(ControlModel.Angle)deg);
    position: absolute;    
    ">
    <iframe src="@ControlModel.Url" frameborder="0" style="
        width: @(ControlModel.Zoom*100)%;
        height: @(ControlModel.Zoom*100)%;
        opacity: @ControlModel.Opacity;">        
    </iframe>
</div>
}

@code
{
    private string guid = Guid.NewGuid().ToString("N");
    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {
            ZTContext.JSRuntime.InvokeVoidAsync("eval",$@"
    let intervalId = null;
    let preRect=null;
    intervalId = setInterval(function(){{
        let g = document.getElementById('web_g_{ControlModel.Name}');
        let div = document.getElementById('div_{guid}');
        if(div==null) {{
            clearInterval(intervalId);
            return;
        }}
 
        let rect = g.getBoundingClientRect();
        let zoom = {ControlModel.Zoom};
        if(preRect==null || preRect.left!=rect.left || preRect.top!=rect.top || preRect.width!=rect.width || preRect.height!=rect.height){{
            div.style.left = rect.left + 'px';
            div.style.top = rect.top + 'px';
            div.style.width = rect.width + 'px';
            div.style.height = rect.height + 'px';
            preRect=rect;
            console.log(intervalId);
        }}
    }},100);");
        }
    }
}