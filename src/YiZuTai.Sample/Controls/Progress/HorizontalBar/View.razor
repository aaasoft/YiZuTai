@inherits AbstractControlView<Model>

<BaseControlView T_BaseControl="Model" Model="@ControlModel" ZTContext="ZTContext">
    <!--横条-->
    @{
        var ArgWidth = ControlModel.Width;
        var ArgHeight = ControlModel.Height;
        var ArgMaxValue = ControlModel.MaxValue;
        var ArgMinValue = ControlModel.MinValue;
        var ArgProgressForegroundColor = ControlModel.ProgressForeground;
        var ArgProgressForegroundOpacity = ControlModel.ProgressForegroundOpacity;
        var ArgProgressBackgroundColor = ControlModel.Background;
        var ArgProgressBackgroundOpacity = ControlModel.BackgroundOpacity;
        var ArgBorderColor = ControlModel.Border;
        var ArgBorderOpacity = ControlModel.BorderOpacity;
        var ArgBorderThickness = ControlModel.BorderThickness;
        var ArgCornerRadius = ControlModel.CornerRadius;
    }
    @{
        var BackgroundProgressLeft = ArgBorderThickness / 2;
        var BackgroundProgressTop = ArgBorderThickness / 2;
        var BackgroundProgressWidth = ArgWidth - ArgBorderThickness;
        var BackgroundProgressHeight = ArgHeight - ArgBorderThickness;

        var ForegroundProgressLeft = ArgBorderThickness;
        var ForegroundProgressTop = ArgBorderThickness;
        var ForegroundProgressPreWidth = (ArgWidth - ArgBorderThickness * 2) * (preValue - ArgMinValue) / (ArgMaxValue - ArgMinValue);
        var ForegroundProgressWidth = (ArgWidth - ArgBorderThickness * 2) * (currentValue - ArgMinValue) / (ArgMaxValue - ArgMinValue);
        var ForegroundProgressHeight = ArgHeight - ArgBorderThickness * 2;
        var ForegroundProgressCornerRadius = ArgCornerRadius - 1;
        if (ForegroundProgressCornerRadius < 0)
            ForegroundProgressCornerRadius = 0;
    }
    <g>
        <rect x="@BackgroundProgressLeft" y="@BackgroundProgressTop" width="@BackgroundProgressWidth"
            height="@BackgroundProgressHeight" fill="@ArgProgressBackgroundColor"
            fill-opacity="@ArgProgressBackgroundOpacity" rx="@ArgCornerRadius" ry="@ArgCornerRadius"
            stroke="@ArgBorderColor" stroke-opacity="@ArgBorderOpacity" stroke-width="@ArgBorderThickness" />
        <rect x="@ForegroundProgressLeft" y="@ForegroundProgressTop" width="@ForegroundProgressPreWidth"
            height="@ForegroundProgressHeight" fill="@ArgProgressForegroundColor"
            fill-opacity="@ArgProgressForegroundOpacity" rx="@ForegroundProgressCornerRadius"
            ry="@ForegroundProgressCornerRadius">
            <animate attributeType="XML" attributeName="width" begin="indefinite" to="@ForegroundProgressWidth" dur="0.5s" fill="freeze" />
        </rect>
    </g>
    <!--文本-->
    <TextView
            ArgTextVisiable="@ControlModel.TextVisiable"
            ArgTextFillColor = "@ControlModel.TextForeground"
            ArgTextFillOpacity = "@ControlModel.TextForegroundOpacity"
            ArgTextX = "@ControlModel.TextX"
            ArgTextY = "@ControlModel.TextY"
            ArgTextFontSize = "@ControlModel.TextFontSize"
            ArgTextFontFamily = "@ControlModel.TextFontFamily"
            ArgText = "@ControlModel.Text" />
</BaseControlView>

@code
{
    private bool isFirst=true;
    private double preValue;
    private double currentValue;

    protected override bool ShouldRender()
    {
        if (isFirst)
        {
            isFirst = false;
            preValue = ControlModel.MinValue;
        }
        else
        {
            preValue = currentValue;
        }
        currentValue = ControlModel.NumberValue;
        return base.ShouldRender();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if(currentValue!=preValue)
            ZTContext.JSRuntime.InvokeVoidAsync("YiZuTai.BeginAnimate", ControlModel.Name);
    }

    public override void OnDoubleClick()
    {
        SourceTypeEditor.Select(ZTContext.ModalWindow, ControlModel.Value, typeof(IDataSource), t => ControlModel.Value =
        (IDataSource)t);
    }
}
