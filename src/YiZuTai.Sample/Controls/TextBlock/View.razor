@inherits AbstractControlView<Model>

<BaseControl_WithBackgroundAndAnimateView T_BaseControl_WithBackgroundAndAnimate="Model" Model="ControlModel"
      DesignMode="@ZTContext.DesignMode">
      <!--图片部分-->
      @if (ControlModel.Image != null)
      {
            <g>
                  <image href="@Core.ZTFile.GetStaticResourceUrl(ZTContext.ZTFile.Id, ControlModel.Image)"
                        width="@ControlModel.Width" height="@ControlModel.Height" preserveAspectRatio="none"></image>
            </g>
      }
      <!--文本部分-->
      <g>
            <text fill="@ControlModel.Foreground" x="@ControlModel.TextX" y="@ControlModel.TextY"
                  font-size="@ControlModel.FontSize" font-weight="@ControlModel.FontWeight"
                  font-family="@ControlModel.FontFamily" text-anchor="@ControlModel.TextAnchor"
                  xml:space="preserve">@ControlModel.Text</text>
      </g>
</BaseControl_WithBackgroundAndAnimateView>

@code
{
      public override void OnDoubleClick()
      {
            SourceTypeEditor.Select(ZTContext.ModalWindow, ControlModel.Value, typeof(IDataSource), t => ControlModel.Value =
            (IDataSource)t);
      }
}
