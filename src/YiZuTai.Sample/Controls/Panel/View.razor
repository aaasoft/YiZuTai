@inherits AbstractControlView<Model>

<ContainerControlView TContainerModel="Model" ZTContext="ZTContext" ControlModel="ControlModel">
    <!--图片部分-->
    <g data-Angle="@ControlModel.Angle">
        <image href="@ZTContext.ZTFile.GetStaticResourceUrl(ControlModel.Image)"
            width="@ControlModel.Width" height="@ControlModel.Height" preserveAspectRatio="none"></image>
    </g>
    @if (ZTContext.DesignMode && ControlModel.BorderThickness <= 0)
    {
        <rect fill-opacity="0" stroke="#6E6E6E" stroke-dasharray="1" stroke-width="1" x="0.5" y="0.5"
            width="@(ControlModel.Width - 1)" height="@(ControlModel.Height - 1)"></rect>
    }
</ContainerControlView>