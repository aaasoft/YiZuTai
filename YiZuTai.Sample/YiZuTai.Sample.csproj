<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageIcon>logo.png</PackageIcon>
	<RepositoryUrl>https://github.com/aaasoft/YiZuTai</RepositoryUrl>
	<PackageProjectUrl>https://github.com/aaasoft/YiZuTai</PackageProjectUrl>
	<PackageTags>易组态;YiZuTai</PackageTags>
	<Description>易组态</Description>
	<Product>易组态示例库</Product>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
	<ItemGroup>
		<None Include="../README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
  
  <ItemGroup>
		<None Include="..\resource\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YiZuTai\YiZuTai.csproj" />
  </ItemGroup>

</Project>
