@inherits AbstractControlHtmlView<Model>

<FloatDivView ZTContext="@ZTContext" ControlModel="ControlModel" DivAttributes="DivAttributes">
    <iframe src="@ControlModel.Url" frameborder="0" style="
        width: @(ControlModel.Zoom * 100)%;
        height: @(ControlModel.Zoom * 100)%;
        opacity: @ControlModel.Opacity;">
    </iframe>
</FloatDivView>

@code
{
    private Dictionary<string, object> DivAttributes => new()
    {
        ["transform"] = $"scale({1 / ControlModel.Zoom}) rotate({ControlModel.Angle}deg)",
        ["transform-origin"] = ControlModel.Zoom >= 1 ? "left top" : "center top"
    };
}