@inherits EditorBase<double?>

@if (Value == null)
{
    <span class="form-control" style="cursor: pointer;" @onclick="@(e => Value = 1)">(未设置)</span>
}
else
{
    <div class="form-control p-0 pl-1 pr-1 m-0">
        <input type="range" class="form-control p-0 m-0" min="@MinValue" max="@MaxValue" step="@Step" @bind-value="Value">
    </div>
    <div class="input-group-append">
        <button type="button" class="btn btn-outline-danger" @onclick="@(e => Value = null)">
            <i class="fa fa-trash" aria-hidden="true"></i>
        </button>
    </div>
}