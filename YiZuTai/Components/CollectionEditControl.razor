<div class="row">
    <div class="col-5">
        <div class="card">
            <div class="card-header">
                项
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in ValueList)
                {
                    @if (item == SelectedItem)
                    {
                        <li class="list-group-item active">@item</li>
                    }
                    else
                    {
                        <li class="list-group-item" @onclick=@(e => onItem_Click(item))>@item</li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-secondary btn-block" title="确定" @onclick="btnOk_Click">
            <i class="fa fa-check" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-secondary btn-block" title="添加" @onclick="btnAdd_Click">
            <i class="fa fa-plus" aria-hidden="true"></i>
        </button>
        @if (CanMoveUp)
        {
            <button type="button" class="btn btn-secondary btn-block" title="向上移动" @onclick="btnMoveUp_Click">
                <i class="fa fa-arrow-up" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-secondary btn-block" title="向上移动" disabled>
                <i class="fa fa-arrow-up" aria-hidden="true"></i>
            </button>
        }
        @if (CanMoveDown)
        {
            <button type="button" class="btn btn-secondary btn-block" title="向下移动" @onclick="btnMoveDown_Click">
                <i class="fa fa-arrow-down" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-secondary btn-block" title="向下移动" disabled>
                <i class="fa fa-arrow-down" aria-hidden="true"></i>
            </button>
        }
        @if (CanDelete)
        {
            <button type="button" class="btn btn-danger btn-block" title="删除" @onclick="btnDelete_Click">
                <i class="fa fa-trash" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-danger btn-block" title="删除" disabled>
                <i class="fa fa-trash" aria-hidden="true"></i>
            </button>
        }
    </div>
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                属性
            </div>
            @if (SelectedItem != null)
            {
                <PropertyGrid SelectedObject="SelectedItem"></PropertyGrid>
            }
        </div>
    </div>
</div>